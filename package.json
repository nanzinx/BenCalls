{
  "name": "bencalls",
  "private": true,
  "version": "2.0.0",
  "description": "BenCalls — Sistema de Chamados da Benconsig (front v2)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js tests/*.test.ts tests/*.test.mjs tests/benhermes/*.test.ts",
    "benhermes:sincronizar": "node scripts/sincronizar-benhermes.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "subir": "node scripts/subir.mjs",
    "subir:ngrok": "node scripts/subir.mjs --ngrok",
    "start": "node server/servidor.mjs",
    "pm2:iniciar": "pm2 start ecosystem.config.cjs",
    "pm2:parar": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs bencalls-web",
    "docker:subir": "docker compose up -d --build",
    "docker:tunel": "docker compose --profile tunel up -d --build",
    "verificar": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "pm2": "^7.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=22.18"
  }
}
