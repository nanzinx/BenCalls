# Copie para .env e ajuste. O .env nunca vai para o git.

# Endereço da BenApi. Vazio = modo demonstração (dados fictícios no navegador).
VITE_API_URL=
# A mesma origem, para o servidor liberar no CSP (connect-src). Ex.: https://api.benconsig.com
API_URL=

# Token do Cloudflare Tunnel (Zero Trust → Networks → Tunnels → Install connector).
TUNNEL_TOKEN=

# Versão mostrada no /healthz (o deploy.sh preenche com o commit).
BENCALLS_VERSAO=dev
# Quantas cópias do servidor o pm2 sobe (modo cluster).
PM2_INSTANCIAS=2
# Requisições por minuto por IP antes de responder 429.
LIMITE_POR_MINUTO=600
# Onde publicar a porta no servidor (127.0.0.1 = só local; o túnel não precisa de porta aberta).
BENCALLS_IP=127.0.0.1
BENCALLS_PORTA=8080
# Só entram os IPs de server/ips-liberados.txt (os mesmos do BenHermes). Para somar outros, separados
# por vírgula. Ex.: 1.2.3.4,2001:db8::/32
IPS_LIBERADOS=
# 0 desliga a restrição de IP: só para testar o Docker no seu PC, NUNCA no servidor.
RESTRINGIR_IPS=1
# 1 quando o site é publicado por um túnel que roda NESTE computador (ngrok): o IP real do visitante
# vem no X-Forwarded-For. Sem isso, todo visitante do túnel passaria como "localhost".
CONFIAR_PROXY=

# API de integração com o BenHermes (docs/API-INTEGRACAO.md). Fora do Docker, use a variável;
# no Docker, o segredo fica em deploy/benhermes_segredo.txt. Gere com: openssl rand -hex 32
BENHERMES_SEGREDO=
# Pasta gravável para os eventos recebidos (sem ela, ficam só na memória).
DADOS_DIR=
