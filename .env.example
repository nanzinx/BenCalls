# Copie para .env e ajuste. O .env nunca vai para o git.

# Endereço da BenApi. Vazio = modo demonstração (dados fictícios no navegador).
VITE_API_URL=
# A mesma origem, para o servidor liberar no CSP (connect-src). Ex.: https://api.benconsig.com
API_URL=

# Token do Cloudflare Tunnel (Zero Trust → Networks → Tunnels → Install connector).
TUNNEL_TOKEN=

# Versão mostrada no /healthz (o deploy.sh preenche com o commit).
BENCALLS_VERSAO=dev
# Quantas cópias do servidor o pm2 sobe (modo cluster).
PM2_INSTANCIAS=2
# Requisições por minuto por IP antes de responder 429.
LIMITE_POR_MINUTO=600
# Onde publicar a porta no servidor (127.0.0.1 = só local; o túnel não precisa de porta aberta).
BENCALLS_IP=127.0.0.1
BENCALLS_PORTA=8080
# IPs/faixas bloqueados além de server/ips-bloqueados.txt (separados por vírgula). Ex.: 1.2.3.4,2001:db8::/32
IPS_BLOQUEADOS=
